# Base URL of the PennyWise API (must include the /api prefix).
# In development leave it as /api: Vite proxies it to http://localhost:8000,
# so requests are same-origin and work whether you open localhost or 127.0.0.1.
# For a production build, set the deployed API URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api
