# ── Server ───────────────────────────────────────────────
# Port the Express API listens on (client dev proxy expects 8000)
PORT=8000

# development | production  (development adds stack traces to error responses)
NODE_ENV=development

# Origins allowed by CORS (comma-separated) — the URL(s) the React client is served from
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────
# Local:  mongodb://localhost:27017/pennywise
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pennywise?retryWrites=true&w=majority
MONGODBURI=mongodb://localhost:27017/pennywise

# ── Auth ─────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
